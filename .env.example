# ---------- LLM ----------
# 兼容 OpenAI 协议；默认走 DeepSeek。留空则自动降级为 deterministic 模式（无 LLM 调用）。
# 换成本地自训模型（A6 实测，见 README §14）只需改下面三行，代码零改动：
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen25-1.5b-triple:q4km
#   LLM_API_KEY=ollama   # 本地端点不校验，但必须非空，否则被判为未启用而静默降级
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# ---------- Neo4j ----------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=lexweave
NEO4J_DATABASE=neo4j

# ---------- 图后端 ----------
# auto: 能连上 Neo4j 就用 Neo4j，否则回落 NetworkX 离线镜像
# neo4j | networkx | auto
GRAPH_BACKEND=auto

# ---------- Embedding / Rerank ----------
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=32
RERANK_MODEL_NAME=BAAI/bge-reranker-v2-m3
ALIGN_MODEL_NAME=BAAI/bge-large-zh-v1.5
ALIGN_THRESHOLD=0.85

# ---------- 检索 ----------
TEXT_TOP_K=20
GRAPH_TOP_K=10
HYBRID_TOP_K=8
RRF_K=60

# ---------- 运行 ----------
SESSION_DB_PATH=data/sessions/sessions.sqlite3
CHECKPOINT_DIR=data/sessions/checkpoints
LOG_LEVEL=INFO
